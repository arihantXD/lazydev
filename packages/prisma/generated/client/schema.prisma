generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             Int          @id @default(autoincrement())
  firstName      String
  lastName       String
  email          String       @unique
  password       String
  occupation     String       @default("Student")
  phoneNumber    String?
  place          String?
  aboutMe        String?
  education      Education[]
  skill          Skill[]
  workExperience Experience[]
  stats          Stats[]
  link           Link[]
}

model Education {
  id     Int      @id @default(autoincrement())
  school String
  course String
  score  String
  from   DateTime
  to     DateTime
  userId Int
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Skill {
  id     Int    @id @default(autoincrement())
  title  String
  skills String
  userId Int
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Experience {
  id          Int      @id @default(autoincrement())
  type        String
  about       String?
  role        String
  companyName String
  from        DateTime
  to          DateTime
  userId      Int
  tasks       Task[]
  gitHubLink  String
  liveLink    String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Task {
  id           Int        @id @default(autoincrement())
  value        String
  experienceId Int
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
}

model Stats {
  id     Int    @id @default(autoincrement())
  title  String
  about  String
  userId Int
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Link {
  id     Int    @id @default(autoincrement())
  title  String
  url    String
  userId Int
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}
