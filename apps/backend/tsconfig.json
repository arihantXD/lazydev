{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@repo/db": ["packages/prisma/src"],
      "@repo/schema": ["packages/schema/src"]
    },
    "outDir": "./dist",
    "rootDir": "./src"
  },
  "ts-node": {
    "compilerOptions": {
      "module": "ESNext"
    },
    "esm": true
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
